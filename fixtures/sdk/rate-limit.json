    {
      "name": "counts pending at close during a usage hold are lost, and onError is told",
      "contract": "11",
      "steps": [
        {
          "do": "create",
          "options": {
            "flushIntervalMs": 300
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "script",
          "route": "events",
          "answers": [
            {
              "status": 429,
              "headers": {
                "Retry-After": "30"
              }
            }
          ]
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false
        },
        {
          "do": "waitUntil",
          "withinMs": 2000,
          "requests": {
            "route": "events",
            "count": 1
          }
        },
        {
          "do": "mark",
          "name": "held"
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false
        },
        {
          "do": "close",
          "withinMs": 1500
        },
        {
          "do": "expect",
          "requests": {
            "route": "events",
            "since": "held",
            "count": 0
          },
          "errors": {
            "since": "held",
            "min": 1
          }
        }
      ]
    },
