    {
      "name": "evaluation keeps answering while every route is limited",
      "contract": "7.4",
      "steps": [
        {
          "do": "create",
          "options": {
            "flushIntervalMs": 300
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "status": {
            "stream": "connected"
          }
        },
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "status": 429,
              "headers": {
                "Retry-After": "1"
              },
              "times": "always"
            }
          ]
        },
        {
          "do": "script",
          "route": "stream",
          "answers": [
            {
              "status": 429,
              "headers": {
                "Retry-After": "1"
              },
              "times": "always"
            }
          ]
        },
        {
          "do": "script",
          "route": "events",
          "answers": [
            {
              "status": 429,
              "headers": {
                "Retry-After": "1"
              },
              "times": "always"
            }
          ]
        },
        {
          "do": "dropStreams"
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "status": {
            "lastError": "http_429"
          }
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false,
          "times": 3,
          "withinMs": 200,
          "expect": {
            "value": true,
            "variationIndex": 1
          }
        },
        {
          "do": "wait",
          "ms": 1200
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false,
          "withinMs": 200,
          "expect": {
            "value": true,
            "variationIndex": 1
          }
        }
      ]
    },
    {
      "name": "close does not wait out a Retry-After hold",
