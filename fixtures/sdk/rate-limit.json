{
  "scenarios": [
    {
      "name": "a 429 on the ruleset with Retry-After holds the next poll",
      "contract": "7.4",
      "steps": [
        {
          "do": "create",
          "options": {
            "stream": false,
            "pollIntervalMs": 300
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "status": 429,
              "headers": {
                "Retry-After": "2"
              }
            }
          ]
        },
        {
          "do": "waitUntil",
          "withinMs": 2000,
          "requests": {
            "route": "ruleset",
            "count": 2
          }
        },
        {
          "do": "mark",
          "name": "held"
        },
        {
          "do": "waitUntil",
          "withinMs": 5000,
          "requests": {
            "route": "ruleset",
            "since": "held",
            "count": 1
          }
        },
        {
          "do": "expect",
          "requests": {
            "route": "ruleset",
            "since": "held",
            "after": {
              "min": 1650,
              "max": 3500
            }
          },
          "errors": {
            "min": 1
          }
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false,
          "expect": {
            "value": true,
            "variationIndex": 1
          }
        }
      ]
    },
    {
      "name": "a 429 on the stream holds the stream and the ruleset together",
      "contract": "7.4",
      "steps": [
        {
          "do": "script",
          "route": "stream",
          "answers": [
            {
              "status": 429,
              "headers": {
                "Retry-After": "3"
              }
            }
          ]
        },
        {
          "do": "create",
          "options": {}
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "waitUntil",
          "withinMs": 2000,
          "requests": {
            "route": "stream",
            "count": 1
          }
        },
        {
          "do": "mark",
          "name": "held"
        },
        {
          "do": "waitUntil",
          "withinMs": 6000,
          "requests": {
            "route": "stream",
            "since": "held",
            "count": 1
          }
        },
        {
          "do": "expect",
          "requests": [
            {
              "route": "ruleset",
              "since": "held",
              "count": 1,
              "after": {
                "min": 2650
              }
            },
            {
              "route": "stream",
              "since": "held",
              "after": {
                "min": 2650,
                "max": 5000
              }
            }
          ]
        }
      ]
    },
    {
      "name": "a 429 on the first load holds the first stream attempt",
      "contract": "7.4",
      "steps": [
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "status": 429,
              "headers": {
                "Retry-After": "2"
              }
            }
          ]
        },
        {
          "do": "mark",
          "name": "start"
        },
        {
          "do": "create",
          "options": {}
        },
        {
          "do": "ready",
          "expect": false
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false,
          "expect": {
            "value": false,
            "variationIndex": null,
            "reason": {
              "kind": "ERROR",
              "code": "NOT_READY"
            }
          }
        },
        {
          "do": "waitUntil",
          "withinMs": 5000,
          "requests": {
            "route": "stream",
            "count": 1
          }
        },
        {
          "do": "expect",
          "requests": {
            "route": "stream",
            "since": "start",
            "after": {
              "min": 1650
            }
          },
          "status": {
            "lastError": null
          }
        },
        {
          "do": "waitUntil",
          "withinMs": 2000,
          "status": {
            "etag": "{{etag}}"
          }
        }
      ]
    },
    {
      "name": "a 429 on a refresh the stream asked for ends the stream and holds the refresh and the reconnect",
      "contract": "7.4",
      "steps": [
        {
          "do": "create",
          "options": {}
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "status": {
            "stream": "connected"
          }
        },
        {
          "do": "mark",
          "name": "m"
        },
        {
          "do": "ruleset",
          "flags": [
            {
              "key": "checkout",
              "serves": false
            }
          ]
        },
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "status": 429,
              "headers": {
                "Retry-After": "2"
              }
            }
          ]
        },
        {
          "do": "publish"
        },
        {
          "do": "waitUntil",
          "withinMs": 2000,
          "requests": {
            "route": "ruleset",
            "since": "m",
            "count": 1,
            "answered": 429
          }
        },
        {
          "do": "mark",
          "name": "held"
        },
        {
          "do": "waitUntil",
          "withinMs": 5000,
          "requests": {
            "route": "stream",
            "since": "held",
            "count": 1
          }
        },
        {
          "do": "expect",
          "requests": {
            "route": "stream",
            "since": "held",
            "after": {
              "min": 1650,
              "max": 3500
            }
          }
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "status": {
            "etag": "{{etag}}",
            "stream": "connected"
          }
        },
        {
          "do": "expect",
          "requests": {
            "route": "ruleset",
            "since": "held",
            "after": {
              "min": 1650
            }
          }
        }
      ]
    },
