            "route": "stream",
            "count": 1
          }
        },
        {
          "do": "close",
          "withinMs": 1500
        }
      ]
    },
    {
      "name": "a 429 on events holds only the usage reports",
      "contract": "9",
      "steps": [
        {
          "do": "create",
          "options": {
            "stream": false,
            "pollIntervalMs": 300,
            "flushIntervalMs": 300
