    {
      "name": "UTF-8 split across reads does not break the stream",
      "contract": "7.2",
      "steps": [
        {
          "do": "create",
          "options": {}
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "status": {
            "stream": "connected"
          }
        },
        {
          "do": "mark",
          "name": "m"
        },
        {
          "do": "ruleset",
          "flags": [
            {
              "key": "checkout",
              "serves": false
            }
          ]
        },
        {
          "do": "write",
          "chunks": [
            [58, 32, 99, 97, 102, 195],
            [169, 10, 10],
            "event: note\ndata: über ☃\n\n",
            "event: changed\ndata: {{etag}}\n\n"
          ]
        },
        {
          "do": "waitUntil",
          "withinMs": 2000,
          "status": {
            "etag": "{{etag}}"
          }
        },
        {
          "do": "expect",
          "requests": [
            {
              "route": "stream",
              "count": 1
            },
            {
              "route": "ruleset",
              "since": "m",
              "count": 1
            }
          ]
        }
      ]
    },
