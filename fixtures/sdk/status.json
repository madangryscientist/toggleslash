{
  "scenarios": [
    {
      "name": "nothing is held before the first load",
      "contract": "8",
      "steps": [
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "hang": true
            }
          ]
        },
        {
          "do": "create",
          "options": {}
        },
        {
          "do": "expect",
          "status": {
            "etag": null,
            "lastSyncAt": null,
            "stream": "connecting",
            "lastError": null
          }
        }
      ]
    },
    {
      "name": "after the first load: the tag, a sync time, connected",
      "contract": "8",
      "steps": [
        {
          "do": "mark",
          "name": "before"
        },
        {
          "do": "create",
          "options": {}
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "status": {
            "etag": "{{etag}}",
            "stream": "connected",
            "lastError": null,
            "lastSyncAt": {
              "after": "before"
            }
          }
        }
      ]
    },
    {
      "name": "with the stream off a 304 moves the sync time and keeps the tag",
      "contract": "8",
      "steps": [
        {
          "do": "create",
          "options": {
            "stream": false,
            "pollIntervalMs": 300
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "expect",
          "status": {
            "stream": "off"
          }
        },
        {
          "do": "mark",
          "name": "m"
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "requests": {
            "route": "ruleset",
            "since": "m",
            "count": 1,
            "answered": 304
          },
          "status": {
            "etag": "{{etag}}",
            "stream": "off",
            "lastSyncAt": {
              "after": "m"
            }
          }
        }
      ]
    },
    {
      "name": "a published change moves the tag and the sync time",
      "contract": "8",
      "steps": [
        {
          "do": "create",
          "options": {}
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "status": {
            "stream": "connected"
          }
        },
        {
          "do": "mark",
          "name": "m"
        },
        {
          "do": "ruleset",
          "flags": [
            {
              "key": "checkout",
              "serves": false
            }
          ]
        },
        {
          "do": "publish"
        },
        {
          "do": "waitUntil",
          "withinMs": 2000,
          "status": {
            "etag": "{{etag}}",
            "lastSyncAt": {
              "after": "m"
            }
          }
        }
      ]
    },
    {
      "name": "a keep-alive does not move the sync time, an event naming the tag held does",
      "contract": "8",
      "steps": [
        {
          "do": "create",
          "options": {}
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "status": {
            "stream": "connected"
          }
        },
        {
          "do": "wait",
          "ms": 50
        },
        {
          "do": "mark",
          "name": "m"
        },
        {
          "do": "write",
          "chunks": [": keep-alive\n\n"]
        },
        {
          "do": "wait",
          "ms": 200
        },
        {
          "do": "expect",
          "status": {
            "stream": "connected",
            "lastSyncAt": {
              "before": "m"
            }
          },
          "requests": {
            "since": "m",
            "count": 0
          }
        },
        {
          "do": "write",
          "chunks": ["event: changed\ndata: {{etag}}\n\n"]
        },
        {
          "do": "waitUntil",
          "withinMs": 2000,
          "status": {
            "lastSyncAt": {
              "after": "m"
            }
          }
        }
      ]
    },
    {
      "name": "a dropped stream reads disconnected, then connected again",
      "contract": "8",
      "steps": [
        {
          "do": "create",
          "options": {}
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "status": {
            "stream": "connected"
          }
        },
        {
          "do": "dropStreams"
        },
        {
          "do": "waitUntil",
          "withinMs": 1000,
          "status": {
            "stream": "disconnected"
          }
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "status": {
            "stream": "connected"
          }
        }
      ]
    },
    {
      "name": "a refused ruleset gives its HTTP status",
      "contract": "8",
      "steps": [
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "status": 401
            },
            {
              "status": 500
            }
          ]
        },
        {
          "do": "create",
          "options": {
            "stream": false,
            "pollIntervalMs": 300
          }
        },
        {
          "do": "ready",
          "expect": false
        },
        {
          "do": "expect",
          "status": {
            "lastError": "http_401",
            "etag": null
          },
          "errors": 1
        },
        {
          "do": "waitUntil",
          "withinMs": 2000,
          "status": {
            "lastError": "http_500"
          }
        },
        {
          "do": "waitUntil",
          "withinMs": 2000,
          "status": {
            "lastError": null,
            "etag": "{{etag}}"
          }
        }
      ]
    },
    {
      "name": "an answer that is not a ruleset is bad_ruleset and replaces nothing",
      "contract": "5.5",
      "steps": [
        {
          "do": "create",
          "options": {
            "stream": false,
            "pollIntervalMs": 200
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "mark",
          "name": "m"
        },
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "body": "<html>502 Bad Gateway</html>"
            },
            {
              "json": {}
            },
            {
              "body": "{\"flags\":["
            },
            {
              "json": [1]
            },
            {
              "json": "text"
            },
            {
              "json": {
                "flags": {},
                "segments": []
              }
            },
            {
              "json": {
                "flags": []
              }
            }
          ]
        },
        {
          "do": "waitUntil",
          "withinMs": 2000,
          "status": {
            "lastError": "bad_ruleset"
          }
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false,
          "expect": {
            "value": true,
            "variationIndex": 1
          }
        },
        {
          "do": "waitUntil",
          "withinMs": 5000,
          "requests": {
            "route": "ruleset",
            "since": "m",
            "count": {
              "min": 8
            }
          }
        },
        {
          "do": "expect",
          "errors": {
            "since": "m",
            "min": 7
          },
          "status": {
            "etag": "{{etag}}",
            "lastError": null
          }
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false,
          "expect": {
            "value": true,
            "variationIndex": 1
          }
        }
      ]
    },
    {
      "name": "a first answer that is not a ruleset leaves nothing held",
      "contract": "5.5",
      "steps": [
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "json": {
                "flags": []
              }
            }
          ]
        },
        {
          "do": "create",
          "options": {
            "stream": false
          }
        },
        {
          "do": "ready",
          "expect": false
        },
        {
          "do": "expect",
          "status": {
            "lastError": "bad_ruleset",
            "etag": null,
            "lastSyncAt": null
          }
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false,
          "expect": {
            "value": false,
            "variationIndex": null,
            "reason": {
              "kind": "ERROR",
              "code": "NOT_READY"
            }
          }
        }
      ]
    },
    {
      "name": "a ruleset that never answers is a timeout",
      "contract": "8",
      "steps": [
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "hang": true
            }
          ]
        },
        {
          "do": "create",
          "options": {
            "stream": false,
            "requestTimeoutMs": 600
          }
        },
        {
          "do": "ready",
          "expect": false,
          "withinMs": 1500
        },
        {
          "do": "expect",
          "status": {
            "lastError": "timeout"
          }
        }
      ]
    },
    {
      "name": "a ruleset body that never finishes is a timeout",
      "contract": "7.1",
      "steps": [
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "hangBody": true
            }
          ]
        },
        {
          "do": "create",
          "options": {
            "stream": false,
            "requestTimeoutMs": 600
          }
        },
        {
          "do": "ready",
          "expect": false,
          "withinMs": 1500
        },
        {
          "do": "expect",
          "status": {
            "lastError": "timeout",
            "etag": null
          }
        }
      ]
    },
    {
      "name": "a stream that does not open within the request timeout is a timeout",
      "contract": "7.2",
      "steps": [
        {
          "do": "script",
          "route": "stream",
          "answers": [
            {
              "hang": true
            }
          ]
        },
        {
          "do": "create",
          "options": {
            "requestTimeoutMs": 600
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "waitUntil",
          "withinMs": 2500,
          "status": {
            "lastError": "timeout"
          },
          "requests": {
            "route": "stream",
            "count": 1
          }
        }
      ]
    },
    {
      "name": "a server that refuses connections is a network error",
      "contract": "8",
      "steps": [
        {
          "do": "down"
        },
        {
          "do": "create",
          "options": {
            "stream": false
          }
        },
        {
          "do": "ready",
          "expect": false
        },
        {
          "do": "expect",
          "status": {
            "lastError": "network",
            "etag": null
          },
          "errors": {
            "min": 1
          }
        }
      ]
    },
    {
      "name": "after close the status reads closed and still holds the tag",
      "contract": "11",
      "steps": [
        {
          "do": "create",
          "options": {
            "stream": false
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "close"
        },
        {
          "do": "expect",
          "status": {
            "stream": "closed",
            "etag": "{{etag}}"
          }
        }
      ]
    }
  ]
}
