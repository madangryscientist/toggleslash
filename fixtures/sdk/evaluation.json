{
  "scenarios": [
    {
      "name": "targets and rules are evaluated with the evaluator",
      "contract": "4",
      "steps": [
        {
          "do": "ruleset",
          "flags": [
            {
              "key": "vip",
              "variations": [false, true],
              "on": true,
              "offVariation": 0,
              "targets": [
                {
                  "variation": 1,
                  "contextKeys": ["{{sentinel}}"]
                }
              ],
              "prerequisites": [],
              "rules": [],
              "fallthrough": {
                "variation": 0
              },
              "salt": "s",
              "version": 1
            },
            {
              "key": "pro",
              "variations": [false, true],
              "on": true,
              "offVariation": 0,
              "targets": [],
              "prerequisites": [],
              "rules": [
                {
                  "clauses": [
                    {
                      "attribute": "plan",
                      "op": "in",
                      "values": ["pro"]
                    }
                  ],
                  "variation": 1
                }
              ],
              "fallthrough": {
                "variation": 0
              },
              "salt": "s",
              "version": 1
            }
          ]
        },
        {
          "do": "create",
          "options": {
            "stream": false
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "evaluate",
          "flag": "vip",
          "fallback": false,
          "expect": {
            "value": true,
            "variationIndex": 1,
            "reason": {
              "kind": "TARGET_MATCH"
            }
          }
        },
        {
          "do": "evaluate",
          "flag": "pro",
          "fallback": false,
          "context": {
            "key": "{{sentinel}}",
            "attributes": {
              "plan": "pro"
            }
          },
          "expect": {
            "value": true,
            "variationIndex": 1
          }
        },
        {
          "do": "evaluate",
          "flag": "pro",
          "fallback": false,
          "context": {
            "key": "{{sentinel}}",
            "attributes": {
              "plan": "free"
            }
          },
          "expect": {
            "value": false,
            "variationIndex": 0,
            "reason": {
              "kind": "FALLTHROUGH"
            }
          }
        }
      ]
    },
    {
      "name": "a context with no key gets the fallback and INVALID_CONTEXT",
      "contract": "4",
      "steps": [
        {
          "do": "create",
          "options": {
            "stream": false
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false,
          "context": {
            "attributes": {}
          },
          "expect": {
            "value": false,
            "variationIndex": null,
            "reason": {
              "kind": "ERROR",
              "code": "INVALID_CONTEXT"
            }
          }
        }
      ]
    },
    {
      "name": "an unknown flag gets the fallback and FLAG_NOT_FOUND",
      "contract": "4",
      "steps": [
        {
          "do": "create",
          "options": {
            "stream": false
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "evaluate",
          "flag": "no-such-flag",
          "fallback": "fb",
          "accessor": "string",
          "expect": {
            "value": "fb",
            "variationIndex": null,
            "reason": {
              "kind": "ERROR",
              "code": "FLAG_NOT_FOUND"
            }
          }
        }
      ]
    },
    {
      "name": "a value of another kind than the fallback is TYPE_MISMATCH",
      "contract": "4",
      "steps": [
        {
          "do": "ruleset",
          "flags": [
            {
              "key": "checkout",
              "serves": true
            },
            {
              "key": "nothing",
              "variations": [null, true],
              "on": true,
              "offVariation": 0,
              "targets": [],
              "prerequisites": [],
              "rules": [],
              "fallthrough": {
                "variation": 0
              },
              "salt": "s",
              "version": 1
            },
            {
              "key": "list",
              "variations": [
                [1],
                {
                  "a": 1
                }
              ],
              "on": true,
              "offVariation": 0,
              "targets": [],
              "prerequisites": [],
              "rules": [],
              "fallthrough": {
                "variation": 0
              },
              "salt": "s",
              "version": 1
            }
          ]
        },
        {
          "do": "create",
          "options": {
            "stream": false
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": "x",
          "accessor": "string",
          "expect": {
            "value": "x",
            "variationIndex": null,
            "reason": {
              "kind": "ERROR",
              "code": "TYPE_MISMATCH"
            }
          }
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": 0,
          "accessor": "number",
          "expect": {
            "value": 0,
            "variationIndex": null,
            "reason": {
              "kind": "ERROR",
              "code": "TYPE_MISMATCH"
            }
          }
        },
        {
          "do": "evaluate",
          "flag": "nothing",
          "fallback": false,
          "accessor": "bool",
          "expect": {
            "value": false,
            "variationIndex": null,
            "reason": {
              "kind": "ERROR",
              "code": "TYPE_MISMATCH"
            }
          }
        },
        {
          "do": "evaluate",
          "flag": "list",
          "fallback": {},
          "accessor": "json",
          "expect": {
            "value": {},
            "variationIndex": null,
            "reason": {
              "kind": "ERROR",
              "code": "TYPE_MISMATCH"
            }
          }
        },
        {
          "do": "evaluate",
          "flag": "list",
          "fallback": [],
          "accessor": "json",
          "expect": {
            "value": [1],
            "variationIndex": 0,
            "reason": {
              "kind": "FALLTHROUGH"
            }
          }
        }
      ]
    },
