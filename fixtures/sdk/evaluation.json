    {
      "name": "a whole number and a fraction are both numbers to a number accessor",
      "contract": "4",
      "steps": [
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "body": "{\"flags\":[{\"key\":\"ratio\",\"variations\":[1.5, 3],\"on\":true,\"offVariation\":0,\"targets\":[],\"prerequisites\":[],\"rules\":[],\"fallthrough\":{\"variation\":0},\"salt\":\"s\",\"version\":1},{\"key\":\"two\",\"variations\":[2.0, 3],\"on\":true,\"offVariation\":0,\"targets\":[],\"prerequisites\":[],\"rules\":[],\"fallthrough\":{\"variation\":0},\"salt\":\"s\",\"version\":1},{\"key\":\"huge\",\"variations\":[1e20, 3],\"on\":true,\"offVariation\":0,\"targets\":[],\"prerequisites\":[],\"rules\":[],\"fallthrough\":{\"variation\":0},\"salt\":\"s\",\"version\":1},{\"key\":\"whole\",\"variations\":[4, 3],\"on\":true,\"offVariation\":0,\"targets\":[],\"prerequisites\":[],\"rules\":[],\"fallthrough\":{\"variation\":0},\"salt\":\"s\",\"version\":1}],\"segments\":[]}",
              "headers": {
                "ETag": "\"ints\""
              }
            }
          ]
        },
        {
          "do": "create",
          "options": {
            "stream": false
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "evaluate",
          "flag": "ratio",
          "fallback": 0,
          "accessor": "number",
          "expect": {
