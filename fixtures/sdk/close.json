{
  "scenarios": [
    {
      "name": "close stops every request and is safe to call twice at once",
      "contract": "11",
      "steps": [
        {
          "do": "create",
          "options": {
            "flushIntervalMs": 300
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "status": {
            "stream": "connected"
          }
        },
        {
          "do": "close",
          "calls": 2,
          "withinMs": 2000
        },
        {
          "do": "mark",
          "name": "closed"
        },
        {
          "do": "close"
        },
        {
          "do": "wait",
          "ms": 800
        },
        {
          "do": "expect",
          "requests": {
            "since": "closed",
            "count": 0
          },
          "openStreams": 0,
          "errors": 0
        }
      ]
    },
    {
      "name": "evaluation still answers from the ruleset after close",
      "contract": "11",
      "steps": [
        {
          "do": "create",
          "options": {
            "hook": true
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "close"
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false,
          "expect": {
            "value": true,
            "variationIndex": 1,
            "reason": {
              "kind": "FALLTHROUGH"
            }
          }
        },
        {
          "do": "expect",
          "hookEvents": {
            "count": 1
          }
        }
      ]
    },
    {
      "name": "close before the first load settles ready false",
      "contract": "11",
      "steps": [
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "hang": true
            }
          ]
        },
        {
          "do": "create",
          "options": {
            "requestTimeoutMs": 5000
          }
        },
        {
          "do": "close",
          "withinMs": 1000
        },
        {
          "do": "ready",
          "expect": false,
          "withinMs": 500
        },
        {
          "do": "expect",
          "errors": 0,
          "requests": {
            "route": "stream",
            "count": 0
          }
        }
      ]
    },
    {
      "name": "close abandons a stream mid-backoff without an error",
      "contract": "11",
      "steps": [
        {
          "do": "script",
          "route": "stream",
          "answers": [
            {
              "status": 503,
              "times": "always"
            }
          ]
        },
        {
          "do": "create",
          "options": {}
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "requests": {
            "route": "stream",
            "count": 1
          },
          "errors": {
            "min": 1
          }
        },
        {
          "do": "mark",
          "name": "m"
        },
        {
          "do": "close",
          "withinMs": 1000
        },
        {
          "do": "wait",
          "ms": 500
        },
        {
          "do": "expect",
          "requests": {
            "since": "m",
            "route": "stream",
            "count": 0
          },
          "errors": {
            "since": "m",
            "max": 0
          }
        }
      ]
    },
    {
      "name": "a close from onError on the SDK's own thread returns without waiting",
      "contract": "6.4",
      "steps": [
        {
          "do": "create",
          "options": {
            "stream": false,
            "pollIntervalMs": 200,
            "requestTimeoutMs": 2000,
            "closeInOnError": true
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false,
          "expect": {
            "value": true,
            "variationIndex": 1,
            "reason": {
              "kind": "FALLTHROUGH"
            }
          }
        },
        {
          "do": "script",
          "route": "events",
          "answers": [
            {
              "hang": true,
              "times": "always"
            }
          ]
        },
        {
          "do": "script",
          "route": "ruleset",
          "answers": [
            {
              "status": 500
            }
          ]
        },
        {
          "do": "waitUntil",
          "withinMs": 3000,
          "callbackClose": {
            "calls": 1
          }
        },
        {
          "do": "expect",
          "callbackClose": {
            "threw": 0,
            "maxMs": {
              "max": 500
            }
          }
        },
        {
          "do": "waitUntil",
          "withinMs": 6000,
          "status": {
            "stream": "closed"
          },
          "openStreams": 0
        },
        {
          "do": "waitUntil",
          "withinMs": 6000,
          "requests": {
            "route": "events",
            "count": {
              "min": 1
            }
          }
        }
      ]
    },
    {
      "name": "a close from a hook returns and the client ends closed",
      "contract": "6.4",
      "steps": [
        {
          "do": "create",
          "options": {
            "closeInHook": true
          }
        },
        {
          "do": "ready",
          "expect": true
        },
        {
          "do": "evaluate",
          "flag": "checkout",
          "fallback": false,
          "expect": {
            "value": true,
            "variationIndex": 1,
            "reason": {
              "kind": "FALLTHROUGH"
            }
          }
        },
        {
          "do": "expect",
          "callbackClose": {
            "calls": 1,
            "threw": 0,
            "maxMs": {
              "max": 5000
            }
          }
        },
        {
          "do": "waitUntil",
          "withinMs": 6000,
          "status": {
            "stream": "closed"
          },
          "openStreams": 0,
          "requests": {
            "route": "events",
            "events": [
              {
                "flag": "checkout",
                "variationIndex": 1,
                "count": 1,
                "day": "{{today}}"
              }
            ]
          }
        }
      ]
    }
  ]
}
