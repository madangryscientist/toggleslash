{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "useDaemonProcess": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/.oxlintrc.json",
      "{workspaceRoot}/scripts/check-slop.ts",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/global.json",
      "{workspaceRoot}/.tool-versions",
      "{workspaceRoot}/apps/server/Directory.Build.*"
    ]
  },
  "targetDefaults": {
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^default"]
    }
  },
  "affected": {
    "legacy": true
  },
  "plugins": [
    {
      "plugin": "@nx/dotnet",
      "options": {
        "restore": true,
        "build": {
          "dependsOn": ["restore", "^build"]
        }
      }
    }
  ]
}
