#!/bin/sh
# The native lint and format check, with no warning allowed: ruff's rules (pyproject.toml), then its formatter in
# check mode. `bin/test` byte-compiles; this reads the code.
set -eu
cd "$(dirname "$0")/.."
run() {
  if command -v mise >/dev/null 2>&1; then mise exec -- "$@"; else "$@"; fi
}
run ruff check --no-cache src tests test-service
run ruff format --no-cache --check src tests test-service
