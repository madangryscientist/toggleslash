#!/bin/sh
# The native lint and format check, no warnings allowed: ruff check (rules in pyproject.toml) and
# ruff format --check, then a byte-compile of every file under Python's development mode.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

run ruff check --no-cache --output-format concise src tests test-service
run ruff format --no-cache --check src tests test-service
PYTHONDONTWRITEBYTECODE=1 run python -X dev -W error -m compileall -q src tests test-service >/dev/null
