#!/bin/sh
# The native lint and format check: Ruff's lint rules (the set is named in pyproject.toml) over src, tests and
# test-service, then Ruff's formatter in check mode. Nothing is rewritten.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

run ruff check --no-cache src tests test-service
run ruff format --check --no-cache src tests test-service
