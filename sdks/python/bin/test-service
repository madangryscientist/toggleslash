#!/bin/sh
# The conformance test service: prints "listening http://127.0.0.1:<port>" and serves until killed.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  PYTHONPATH=src exec mise exec -- python -X dev -W error test-service/main.py "$@"
fi
PYTHONPATH=src exec python -X dev -W error test-service/main.py "$@"
