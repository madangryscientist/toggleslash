#!/bin/sh
# Every native test, under Python's development mode with warnings as errors. Sources, tests and
# the test service are byte-compiled first so a syntax error anywhere fails here.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

export PYTHONPATH="src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1

run python -X dev -W error - <<'PY'
import pathlib
import sys

failed = False
for root in ("src", "tests", "test-service"):
    for path in sorted(pathlib.Path(root).rglob("*.py")):
        try:
            compile(path.read_text(encoding="utf-8"), str(path), "exec", dont_inherit=True)
        except SyntaxError as error:
            print(f"{path}: {error}", file=sys.stderr)
            failed = True
sys.exit(1 if failed else 0)
PY

run python -X dev -W error -m unittest discover -s tests -t tests "$@"
