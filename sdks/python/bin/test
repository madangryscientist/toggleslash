#!/bin/sh
set -eu
cd "$(dirname "$0")/.."

# Every tool runs through `mise exec --` when mise is on PATH (a mise shim fails in a directory where its tool
# is not active); in CI a setup step puts Python on PATH.
tool() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

# Build: compile every source, test and test-service file in memory under `-W error`, so a syntax error or a
# warning in a file no test imports still fails, and nothing is cached.
files="$(find src tests test-service -type f -name '*.py' | sort)"
# shellcheck disable=SC2086
tool python -X dev -W error -c '
import sys
for path in sys.argv[1:]:
    with open(path, encoding="utf-8") as handle:
        compile(handle.read(), path, "exec", dont_inherit=True)
' $files

# Run: the development mode turns on the runtime checks Python has instead of a race detector, and `-W error`
# makes a warning (an unclosed socket, a thread that raised) a failure.
PYTHONPATH=src tool python -X dev -W error -m unittest discover -s tests -t tests
