#!/bin/sh
# Builds (byte-compiles every source, test and test-service file, so a syntax error in a file no test
# imports still fails) and runs every test under `-X dev -W error`. It never reports a cached result.
set -eu
cd "$(dirname "$0")/.."
run() {
  if command -v mise >/dev/null 2>&1; then mise exec -- "$@"; else "$@"; fi
}
export PYTHONPATH=src
export PYTHONDONTWRITEBYTECODE=
run python -m compileall -q -f src tests test-service
run python -X dev -W error -m unittest discover -s tests -t tests "$@"
