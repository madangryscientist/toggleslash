#!/bin/sh
# Byte-compile (a syntax error fails here), then run every test under the interpreter's development checks
# with warnings as errors. Python has no race detector; the concurrency tests carry that weight.
set -eu
cd "$(dirname "$0")/.."
if command -v mise >/dev/null 2>&1 && [ -f mise.toml ]; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi
run python --version
run python -m compileall -q -f src tests test-service
PYTHONPATH=src run python -X dev -W error -m unittest discover -s tests
