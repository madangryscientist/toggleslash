#!/bin/sh
# Builds everything, runs every test under the race detector, and builds the test service last.
# The race detector needs cgo, so it needs a C compiler: gcc or cc if there is one, else `zig cc`
# (mise.toml pins zig for exactly this).
set -eu
cd "$(dirname "$0")/.."

run() {
	if command -v mise >/dev/null 2>&1; then
		mise exec -- "$@"
	else
		"$@"
	fi
}

if command -v gcc >/dev/null 2>&1; then
	CC=gcc
elif command -v cc >/dev/null 2>&1; then
	CC=cc
else
	CC="zig cc"
fi
export CC CGO_ENABLED=1

scratch="${TMPDIR:-/tmp}"
out="$(mktemp "$scratch/toggleslash-go-test.XXXXXX")"
trap 'rm -f "$out"' EXIT

run go build ./...
if ! run go test -race -count=1 -v ./... >"$out" 2>&1; then
	cat "$out"
	echo "bin/test: FAILED" >&2
	exit 1
fi
grep -E '^(ok|FAIL|---|\?) ' "$out" | grep -v -- '--- PASS' | grep -E '^(ok|\?)' || true
grep -E '^vectors: [0-9]+ pins: [0-9]+$' "$out"

mkdir -p .build
run go build -o .build/test-service ./test-service
