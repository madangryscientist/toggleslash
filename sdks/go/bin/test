#!/bin/sh
# Runs every Go test with the race detector, reports the evaluation vector counts, then builds the
# test service binary. -race needs cgo, so a C compiler must exist: this uses the zig that mise.toml
# pins, by path, because a zig elsewhere on PATH can shadow it.
set -eu
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$0")/.."

if [ -z "${TOGGLESLASH_IN_MISE:-}" ] && command -v mise >/dev/null 2>&1; then
	TOGGLESLASH_IN_MISE=1 exec mise exec -- "$self" "$@"
fi

if [ -n "${TOGGLESLASH_IN_MISE:-}" ]; then
	CC="$(mise where zig)/zig cc"
	export CC
fi

go vet ./...
go test -race -count=1 "$@" ./...
go test -count=1 -v -run '^TestVectors$' ./internal/evaluator | grep 'vectors:'
go build -o bin/.test-service ./test-service
