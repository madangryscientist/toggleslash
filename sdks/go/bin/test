#!/bin/sh
# Builds the module and runs its tests under the race detector, which needs a C
# compiler: mise pins zig and CC points at it. The vectors test prints the
# `vectors: <n> pins: <n>` line, and this script prints it last even when the
# test output above it ends with go's own summary.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
	CC="$(mise where zig)/zig cc"
	export CC
	run() { mise exec -- "$@"; }
else
	run() { "$@"; }
fi

run go build ./...
if ! output=$(run go test -race -count=1 -v ./...); then
	printf '%s\n' "$output"
	printf '%s\n' "bin/test: the tests failed"
	exit 1
fi
printf '%s\n' "$output"
# The test service's binary is the last build step, so bin/test-service finds it
# and the harness never waits for a cold compile.
run go build -o build/testservice ./test-service
counts=$(printf '%s\n' "$output" | grep -E '^vectors: [0-9]+ pins: [0-9]+$' | tail -n 1)
if [ -z "$counts" ]; then
	# A missing count line is a failure, not an empty success: "Entry points"
	# requires bin/test to print it.
	printf '%s\n' "bin/test: the vectors count line is missing from the test output" >&2
	exit 1
fi
printf '%s\n' "$counts"
