#!/bin/sh
# Builds everything (the test service last), then runs every native test under the race detector, vectors
# included. Never reports a cached result. -race needs cgo, so a C compiler must exist: when CC is not set
# and mise is on PATH this uses the zig that mise.toml pins (`zig cc`), named by path.
set -eu
cd "$(dirname "$0")/.."

run() {
	if command -v mise >/dev/null 2>&1; then
		mise exec -- "$@"
	else
		"$@"
	fi
}

if [ -z "${CC:-}" ] && command -v mise >/dev/null 2>&1; then
	zig_dir=$(mise where zig 2>/dev/null || true)
	if [ -n "$zig_dir" ] && [ -x "$zig_dir/zig" ]; then
		CC="$zig_dir/zig cc"
		export CC
	fi
fi
CGO_ENABLED=1
export CGO_ENABLED

run go build ./...
run go test -race -count=1 ./...

counts=$(run go test -count=1 -v -run '^TestVectorCounts$' ./internal/eval)
printf '%s\n' "$counts" | grep '^vectors:'

mkdir -p build
run go build -o build/test-service ./test-service
