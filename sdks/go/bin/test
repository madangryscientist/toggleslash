#!/bin/sh
# Runs every Go test under the race detector, and prints how many evaluation
# vectors the evaluator ran. -race needs cgo, so zig (pinned in mise.toml)
# stands in for a C compiler.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
	run() { mise exec -- "$@"; }
	CC="$(mise where zig)/zig cc"
else
	run() { "$@"; }
	CC="${CC:-cc}"
fi
export CC CGO_ENABLED=1

run go test -race -count=1 -timeout 600s ./...
run go test -count=1 -v -run '^(TestVectors|TestBucketPins)$' ./internal/evaluator |
	sed -n 's/.*vectors: \([0-9]*\)$/\1/p; s/.*pins: \([0-9]*\)$/p\1/p' |
	{
		v=0 p=0
		while read -r n; do
			case $n in p*) p=${n#p} ;; *) v=$n ;; esac
		done
		echo "vectors: $v pins: $p"
	}

# The last step: the test service's binary, which bin/test-service runs.
mkdir -p .build
run go build -o .build/test-service ./test-service
