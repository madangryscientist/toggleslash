#!/bin/sh
# Builds, runs every Go test under the race detector, prints the evaluation vector and pin counts, and builds
# the test-service binary last (bin/test-service runs it).
set -eu
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$0")/.."

if [ -z "${TOGGLESLASH_SDK_GO_MISE:-}" ] && command -v mise >/dev/null 2>&1; then
	TOGGLESLASH_SDK_GO_MISE=1 exec mise exec -- "$self" "$@"
fi

# The race detector needs a C compiler; zig is the one mise.toml pins.
if command -v zig >/dev/null 2>&1; then
	CC="zig cc"
	export CC
fi
CGO_ENABLED=1
export CGO_ENABLED

go build ./...
go test -race -count=1 ./...

counts="$(go test -count=1 -v -run '^(TestVectors|TestBucketPins)$' ./internal/evaluator | grep '^COUNT ')"
vectors="$(printf '%s\n' "$counts" | awk '$2 == "vectors" { print $3 }')"
pins="$(printf '%s\n' "$counts" | awk '$2 == "pins" { print $3 }')"
echo "vectors: ${vectors:-0} pins: ${pins:-0}"

go build -o .build/test-service ./test-service
