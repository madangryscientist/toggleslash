#!/bin/sh
# Builds everything, runs the native tests under the race detector (never a cached result), prints the
# vector and pin counts, and builds the test service binary last. The race detector needs cgo, so a C
# compiler is pinned in mise.toml (zig) and named by path: a zig elsewhere on PATH can shadow it.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
cd "$here/.."

if command -v mise >/dev/null 2>&1; then
	zig=$(mise where zig)/zig
	run() { mise exec -- "$@"; }
else
	zig=$(command -v zig)
	run() { "$@"; }
fi
export CGO_ENABLED=1
export CC="$zig cc"

run go vet ./...
run go test -race -count=1 ./...

counts=$(run go test -race -count=1 -v -run '^(TestVectors|TestBucketPins)$' ./internal/evaluator |
	awk '/ vectors: [0-9]+$/ { v = $NF } / pins: [0-9]+$/ { p = $NF } END { if (v == "" || p == "") exit 1; print "vectors: " v " pins: " p }')
echo "$counts"

run go build -o .build/test-service ./test-service
