#!/bin/sh
# Builds everything, runs every native test under the race detector, prints the vector and pin
# counts, then builds the test service binary last. Needs only what mise.toml pins (go and zig:
# -race needs cgo, and zig is the C compiler, named by path so a zig elsewhere on PATH cannot shadow it).
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
	zig="$(mise exec -- mise where zig)/zig"
	run() { mise exec -- "$@"; }
else
	zig="$(command -v zig)"
	run() { "$@"; }
fi
export CGO_ENABLED=1
export CC="$zig cc"

run go build ./...
# -count=1: never report a cached result.
run go test -race -count=1 ./...

out="$(run go test -race -count=1 -v -run '^(TestVectors|TestBucketPins)$' ./internal/evaluator)"
vectors="$(printf '%s\n' "$out" | sed -n 's/.*vectors: \([0-9][0-9]*\)$/\1/p' | head -n 1)"
pins="$(printf '%s\n' "$out" | sed -n 's/.*pins: \([0-9][0-9]*\)$/\1/p' | head -n 1)"
if [ -z "$vectors" ] || [ -z "$pins" ]; then
	printf '%s\n' "$out" >&2
	echo "bin/test: could not read the vector and pin counts" >&2
	exit 1
fi
echo "vectors: $vectors pins: $pins"

# The test service binary, last. bin/test-service runs it and builds it only when it is missing.
mkdir -p .build
run go build -o .build/test-service ./test-service
