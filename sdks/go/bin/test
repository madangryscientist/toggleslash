#!/bin/sh
# Builds and runs the native tests under the race detector, prints the vector and pin counts, then
# builds the test service the conformance harness starts. The race detector needs cgo, so a C compiler is
# required: mise.toml pins zig and this uses it as `zig cc`.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
	tool() { mise exec -- "$@"; }
else
	tool() { "$@"; }
fi

# A zig elsewhere on PATH (such as ~/.local/bin) can shadow the pinned one even inside `mise exec`, so name the
# pinned compiler by its path.
if command -v mise >/dev/null 2>&1 && pinned="$(mise where zig 2>/dev/null)" && [ -x "$pinned/zig" ]; then
	CC="${CC:-$pinned/zig cc}"
	export CC
elif command -v zig >/dev/null 2>&1; then
	CC="${CC:-zig cc}"
	export CC
fi

tool go test -race -count=1 ./...
tool go test -count=1 -v -run '^TestFixtureCounts$' ./internal/eval | grep '^vectors:'
mkdir -p .build
tool go build -o .build/test-service ./test-service
