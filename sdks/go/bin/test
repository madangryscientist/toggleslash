#!/bin/sh
# Builds everything, runs every native test under the race detector (the evaluation vectors and bucket pins
# included) and prints how many vectors and pins ran. The race detector needs cgo and a C compiler; when the
# machine has none, the pinned Zig (mise.toml) is the C compiler, found by path because a shim for
# another zig can shadow it on PATH.
set -eu
cd "$(dirname "$0")/.."

run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

if [ -z "${CC:-}" ] && ! command -v cc >/dev/null 2>&1 && ! command -v gcc >/dev/null 2>&1; then
  if command -v mise >/dev/null 2>&1; then
    zig_dir=$(mise where zig)
    CC="$zig_dir/zig cc"
    export CC
  fi
fi
export CGO_ENABLED=1

run go build ./...
run go test -race -count=1 ./...

# The counts: the vectors and pins the evaluator package ran, from the tests' own output.
run go test -count=1 -v -run '^(TestVectors|TestBucketPins)$' ./internal/evaluator | grep -E '^(vectors|pins): '
# Last, so the binary bin/test-service runs is the one just built.
run go build -o test-service/test-service ./test-service
