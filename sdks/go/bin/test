#!/bin/sh
# Builds, then runs the native tests (the evaluation vectors included) under the race detector.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

run go build ./...
run go test -race -count=1 ./...
# The vector test prints its counts on stdout, which a passing package hides without -v.
run go test -race -count=1 -v -run '^TestVectorsAndPins$' ./internal/evaluator | grep '^vectors: '
# The test service's binary is the last thing built; bin/test-service runs it.
mkdir -p build
run go build -o build/test-service ./test-service
