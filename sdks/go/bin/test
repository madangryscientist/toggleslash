#!/bin/sh
# Builds, then runs every native test under the race detector (the evaluation vectors included), and last
# builds the test service's binary. The race detector needs cgo, so zig (pinned in mise.toml) is the C
# compiler, named by path: a zig elsewhere on PATH can shadow the pinned one.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
  ZIG="$(mise where zig)/zig"
else
  run() { "$@"; }
  ZIG="$(command -v zig)"
fi
export CC="$ZIG cc"
export CGO_ENABLED=1

mkdir -p .build
run go build ./...
run go test -race -count=1 ./... "$@"

# The counts the evaluator's two tests log. -v shows t.Logf lines on a pass.
run go test -count=1 -v -run '^(TestVectors|TestBucketPins)$' ./internal/evaluator |
  awk '/vectors: [0-9]+/ { v = $NF } /pins: [0-9]+/ { p = $NF } END { if (v == "" || p == "") exit 1; print "vectors: " v " pins: " p }'

run go build -o .build/test-service ./test-service
