#!/bin/sh
# Builds and tests every package with the race detector, never from the test cache, prints the vector and
# pin counts, and builds the test service last. Run from anywhere.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
	run() { mise exec -- "$@"; }
	# The race detector needs a C compiler; the pinned zig is one, so no system compiler is assumed.
	CC="$(mise where zig)/zig cc"
	export CC
else
	run() { "$@"; }
fi
export CGO_ENABLED=1

run go test -race -count=1 ./...

# The two evaluation tests log their counts; print them on one line for the phase 2 check.
counts="$(run go test -race -count=1 -v -run '^(TestVectors|TestBucketPins)$' ./internal/evaluator)"
vectors="$(printf '%s\n' "$counts" | sed -n 's/.*vectors: \([0-9][0-9]*\).*/\1/p')"
pins="$(printf '%s\n' "$counts" | sed -n 's/.*pins: \([0-9][0-9]*\).*/\1/p')"
echo "vectors: $vectors pins: $pins"

mkdir -p .build
run go build -o .build/test-service ./test-service
