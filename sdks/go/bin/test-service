#!/bin/sh
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

# The binary bin/test builds; built here only when it is missing (the harness waits 30 s for `listening`).
if [ ! -x .build/test-service ]; then
  mkdir -p .build
  run go build -o .build/test-service ./test-service
fi
exec .build/test-service
