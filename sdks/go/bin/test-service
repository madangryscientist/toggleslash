#!/bin/sh
# Runs the Go SDK's conformance test service (docs/sdk-test-service.md). bin/test builds it; this builds it
# only if it is missing. The harness waits for the `listening http://127.0.0.1:<port>` line.
set -eu
cd "$(dirname "$0")/.."

run() {
	if command -v mise >/dev/null 2>&1; then
		mise exec -- "$@"
	else
		"$@"
	fi
}

if [ ! -x .build/test-service ]; then
	mkdir -p .build
	run go build -o .build/test-service ./test-service
fi
exec .build/test-service
