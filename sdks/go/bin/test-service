#!/bin/sh
# Starts the conformance test service on a port the OS picks and prints `listening http://127.0.0.1:<port>`.
# It runs the binary bin/test builds (.build/test-service) and builds it here only when it is missing.
set -eu
cd "$(dirname "$0")/.."
if [ ! -x .build/test-service ]; then
  mkdir -p .build
  if command -v mise >/dev/null 2>&1; then
    mise exec -- go build -o .build/test-service ./test-service
  else
    go build -o .build/test-service ./test-service
  fi
fi
exec .build/test-service
