#!/bin/sh
# Runs the conformance test service. It builds only when the binary is missing (bin/test builds it last).
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
	run() { mise exec -- "$@"; }
else
	run() { "$@"; }
fi

if [ ! -x .build/test-service ]; then
	mkdir -p .build
	run go build -o .build/test-service ./test-service
fi
exec .build/test-service
