#!/bin/sh
# Starts the conformance test service on a port the OS picks and prints `listening http://127.0.0.1:<port>`.
# It runs the binary bin/test builds into .build/, and builds it first when it is missing.
set -eu
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$0")/.."
if [ -z "${TOGGLESLASH_SDK_GO_MISE:-}" ] && command -v mise >/dev/null 2>&1; then
	TOGGLESLASH_SDK_GO_MISE=1 exec mise exec -- "$self" "$@"
fi
if [ ! -x .build/test-service ]; then
	go build -o .build/test-service ./test-service
fi
exec .build/test-service
