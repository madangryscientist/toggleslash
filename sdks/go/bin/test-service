#!/bin/sh
# Starts the conformance test service in the foreground. It runs the binary bin/test built, and builds it only
# when it is missing: the harness waits 30 s for the listening line, and a cold compile can take longer.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

if [ ! -x .build/test-service ]; then
  run go build -o .build/test-service ./test-service
fi
exec ./.build/test-service
