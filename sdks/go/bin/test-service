#!/bin/sh
# Starts the conformance test service. It runs the binary bin/test built, and builds it only when it is
# missing, so the harness's 30 s wait for the "listening" line never meets a long build.
set -eu
cd "$(dirname "$0")/.."

if [ ! -x test-service/test-service ]; then
  if command -v mise >/dev/null 2>&1; then
    mise exec -- go build -o test-service/test-service ./test-service
  else
    go build -o test-service/test-service ./test-service
  fi
fi
exec ./test-service/test-service
