#!/bin/sh
# Starts the conformance test service: `bun run conformance -- --service sdks/go/bin/test-service`. It runs the
# binary bin/test builds, and builds it first only if it is missing, so the harness never waits on a compile
# that bin/test already did.
set -eu
cd "$(dirname "$0")/.."

if [ ! -x .build/test-service ]; then
	if command -v mise >/dev/null 2>&1; then
		mise exec -- go build -o .build/test-service ./test-service >&2
	else
		go build -o .build/test-service ./test-service >&2
	fi
fi
exec .build/test-service
