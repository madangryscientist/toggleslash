#!/usr/bin/env bash
# Starts the Go SDK's test service (docs/sdk-test-service.md). It builds the binary first if bin/test has
# not, so the harness's 30 s wait for the "listening" line is not spent compiling a warm tree.
set -euo pipefail
cd "$(dirname "$0")/.."
if [ ! -x .build/test-service ]; then
  go build -o .build/test-service ./test-service
fi
exec .build/test-service
