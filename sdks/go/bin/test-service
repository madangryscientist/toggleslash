#!/bin/sh
# Starts the Go SDK's conformance test service and prints `listening http://127.0.0.1:<port>`.
# It runs the binary bin/test builds (bin/.test-service) and builds it here only when it is missing.
set -eu
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$0")/.."
if [ -z "${TOGGLESLASH_IN_MISE:-}" ] && command -v mise >/dev/null 2>&1; then
	TOGGLESLASH_IN_MISE=1 exec mise exec -- "$self" "$@"
fi
if [ ! -x bin/.test-service ]; then
	go build -o bin/.test-service ./test-service
fi
exec bin/.test-service "$@"
