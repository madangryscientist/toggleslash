#!/bin/sh
# Starts the Go SDK's conformance test service: the binary bin/test built into
# .build/, built here only when it is missing (a cold compile must not eat the
# harness's 30 s wait). It replaces itself with the binary.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
	run() { mise exec -- "$@"; }
else
	run() { "$@"; }
fi

bin=.build/test-service
if [ ! -x "$bin" ]; then
	mkdir -p .build
	run go build -o "$bin" ./test-service >&2
fi
exec "$bin"
