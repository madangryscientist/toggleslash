#!/bin/sh
# The native lint and format check, no warnings allowed: gofmt -l must list nothing,
# go vet and golangci-lint (rules in .golangci.yml) must be clean.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
	run() { mise exec -- "$@"; }
else
	run() { "$@"; }
fi

unformatted="$(run gofmt -l .)"
if [ -n "$unformatted" ]; then
	printf 'gofmt would change:\n%s\n' "$unformatted" >&2
	exit 1
fi
run go vet ./...
run golangci-lint run ./...
