#!/bin/sh
# The Go SDK's lint and format check. Read only; any warning fails it.
set -eu
cd "$(dirname "$0")/.."

run() {
	if command -v mise >/dev/null 2>&1; then
		mise exec -- "$@"
	else
		"$@"
	fi
}

run go vet ./...
run golangci-lint run ./...
unformatted="$(run gofmt -l .)"
if [ -n "$unformatted" ]; then
	echo "gofmt would change:" >&2
	echo "$unformatted" >&2
	exit 1
fi
