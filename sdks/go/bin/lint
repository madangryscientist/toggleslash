#!/bin/sh
# Read-only lint and format check: gofmt (must list nothing), go vet and golangci-lint.
set -eu
cd "$(dirname "$0")/.."

run() {
	if command -v mise >/dev/null 2>&1; then
		mise exec -- "$@"
	else
		"$@"
	fi
}

unformatted=$(run gofmt -l .)
if [ -n "$unformatted" ]; then
	echo "gofmt would change:" >&2
	echo "$unformatted" >&2
	exit 1
fi
run go vet ./...
run golangci-lint run ./...
