#!/bin/sh
# The native lint and format check, no warnings allowed: gofmt (any file it would change fails), go vet and
# golangci-lint (rules in .golangci.yml), all over the whole module including the test service.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
	tool() { mise exec -- "$@"; }
else
	tool() { "$@"; }
fi

unformatted="$(tool gofmt -l .)"
if [ -n "$unformatted" ]; then
	echo "gofmt would change:" >&2
	echo "$unformatted" >&2
	exit 1
fi
tool go vet ./...
tool golangci-lint run --max-issues-per-linter 0 --max-same-issues 0 ./...
