#!/bin/sh
# The native lint and format check, no warnings allowed: `go vet`, golangci-lint (.golangci.yml) and `gofmt -l`,
# which must list no file.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

run go vet ./...
run golangci-lint run ./...
unformatted=$(run gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "gofmt would change:" >&2
  echo "$unformatted" >&2
  exit 1
fi
