#!/bin/sh
# The Go SDK's lint and format check, with no warnings allowed: gofmt -l (a listed file is a failure),
# go vet, and golangci-lint with .golangci.yml. Runs under the toolchain mise.toml pins.
set -eu
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$0")/.."

if [ -z "${TOGGLESLASH_IN_MISE:-}" ] && command -v mise >/dev/null 2>&1; then
	TOGGLESLASH_IN_MISE=1 exec mise exec -- "$self" "$@"
fi

unformatted="$(gofmt -l .)"
if [ -n "$unformatted" ]; then
	echo "gofmt would change:" >&2
	echo "$unformatted" >&2
	exit 1
fi
go vet ./...
golangci-lint run ./...
