#!/bin/sh
# The native lint and format check: go vet, golangci-lint and gofmt in list mode. Nothing is rewritten.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

run go vet ./...
run golangci-lint run ./...
unformatted="$(run gofmt -l .)"
if [ -n "$unformatted" ]; then
  echo "gofmt would change:" >&2
  echo "$unformatted" >&2
  exit 1
fi
