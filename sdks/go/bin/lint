#!/bin/sh
# The native lint and format check, no warnings allowed: go vet, golangci-lint (rules in .golangci.yml) and
# gofmt -l, which must list nothing.
set -eu
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$0")/.."

if [ -z "${TOGGLESLASH_SDK_GO_MISE:-}" ] && command -v mise >/dev/null 2>&1; then
	TOGGLESLASH_SDK_GO_MISE=1 exec mise exec -- "$self" "$@"
fi

go vet ./...
golangci-lint run ./...
unformatted="$(gofmt -l .)"
if [ -n "$unformatted" ]; then
	echo "gofmt would change:" >&2
	echo "$unformatted" >&2
	exit 1
fi
