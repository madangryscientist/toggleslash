#!/bin/sh
# Lint and format check with no warnings allowed: gofmt -s, go vet and golangci-lint. Run from anywhere.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
	run() { mise exec -- "$@"; }
else
	run() { "$@"; }
fi

unformatted="$(run gofmt -s -l .)"
if [ -n "$unformatted" ]; then
	echo "gofmt -s would change:" >&2
	echo "$unformatted" >&2
	exit 1
fi
run go vet ./...
run golangci-lint run ./...
