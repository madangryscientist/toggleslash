#!/bin/sh
# Starts the conformance test service and prints "listening http://127.0.0.1:<port>" once it does.
# It runs the built binary; it builds it only when there is none (bin/test rebuilds every time).
set -eu
cd "$(dirname "$0")/.."

run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
SERVICE=artifacts/bin/ToggleSlash.Sdk.TestService/debug/ToggleSlash.Sdk.TestService.dll
if [ ! -f "$SERVICE" ]; then
  run dotnet build test-service/ToggleSlash.Sdk.TestService.csproj --nologo -v quiet >&2
fi
if command -v mise >/dev/null 2>&1; then
  exec mise exec -- dotnet "$SERVICE"
fi
exec dotnet "$SERVICE"
