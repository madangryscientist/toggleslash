#!/bin/sh
# Starts the conformance test service on the output bin/test built, and builds it only when that output is missing
# (the harness waits 30 s for the "listening" line). Roots read: test-service/ and src/ToggleSlash.Sdk/.
set -eu
cd "$(dirname "$0")/.."

OUT=artifacts/bin/ToggleSlash.Sdk.TestService/debug/ToggleSlash.Sdk.TestService.dll

run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

if [ ! -f "$OUT" ]; then
  run dotnet build test-service/ToggleSlash.Sdk.TestService.csproj --nologo -v q >&2
fi
if command -v mise >/dev/null 2>&1; then
  exec mise exec -- dotnet "$OUT"
fi
exec dotnet "$OUT"
