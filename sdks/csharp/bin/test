#!/bin/sh
# Build everything (the test service last) and run the unit tests plus the evaluation vectors, every time: the build
# is never skipped and a cached test result is never reported (no --no-build, and the vstest result is not cached).
set -eu
cd "$(dirname "$0")/.."

run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

run dotnet build src/ToggleSlash.Sdk/ToggleSlash.Sdk.csproj --nologo -v q
run dotnet test tests/ToggleSlash.Sdk.Tests/ToggleSlash.Sdk.Tests.csproj --nologo -v q --logger "console;verbosity=detailed"
if [ -f test-service/ToggleSlash.Sdk.TestService.csproj ]; then
  run dotnet build test-service/ToggleSlash.Sdk.TestService.csproj --nologo -v q
fi
