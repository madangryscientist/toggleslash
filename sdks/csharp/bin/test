#!/bin/sh
# Builds everything (the SDK, its tests and the test service), runs every native test (the evaluation
# vectors and bucket pins included) and prints how many vectors and pins ran. The test service is built last,
# so bin/test-service finds it; bin/test-service builds only when the binary is missing.
set -eu
cd "$(dirname "$0")/.."

run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
mkdir -p artifacts
counts="$PWD/artifacts/vector-counts.txt"
rm -f "$counts"
export TOGGLESLASH_COUNTS_FILE="$counts"

# Build every time, so a stale build never hides a failure. The race detector that other languages have does
# not exist for .NET; the stress tests in tests/ToggleSlash.Sdk.Tests/ConcurrencyTests.cs stand in for it.
run dotnet build ToggleSlash.Sdk.slnx --nologo -v quiet
run dotnet test tests/ToggleSlash.Sdk.Tests/ToggleSlash.Sdk.Tests.csproj --no-build --nologo -v quiet

cat "$counts"
# Last, so the binary bin/test-service runs is the one just built.
run dotnet build test-service/ToggleSlash.Sdk.TestService.csproj --nologo -v quiet
