#!/bin/sh
# The native lint and format check, with no warnings allowed: `dotnet format` must find nothing to change in
# whitespace, code style or analyzer fixes, and a build with warnings as errors (Directory.Build.props, the rules
# and the reasons for each rule left off in .editorconfig) must be clean.
# Roots read: src/ToggleSlash.Sdk (the library), tests/* (the unit tests and NeverClosed) and test-service (the
# conformance test service), all listed by ToggleSlash.Sdk.slnx.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

run dotnet format whitespace ToggleSlash.Sdk.slnx --verify-no-changes
run dotnet format style ToggleSlash.Sdk.slnx --verify-no-changes
run dotnet format analyzers ToggleSlash.Sdk.slnx --verify-no-changes
run dotnet build ToggleSlash.Sdk.slnx --nologo -v q -warnaserror
