<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ToggleSlash.Sdk.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <!-- The tests are not the product: the analyzers that guard public API shape stay on the library. -->
    <AnalysisMode>Default</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ToggleSlash.Sdk/ToggleSlash.Sdk.csproj" />
    <!-- Built first so the process-exit test can run it; its assembly is not referenced. -->
    <ProjectReference Include="../ToggleSlash.Sdk.NeverClosed/ToggleSlash.Sdk.NeverClosed.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
