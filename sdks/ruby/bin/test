#!/bin/sh
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

# Ruby is interpreted, so there is nothing to build and nothing to cache. `-w` turns on Ruby's warnings
# and test_helper.rb makes any warning fail the run.
run ruby -w -I lib -I test test/run_all.rb
