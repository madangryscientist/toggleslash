<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  The Java SDK's Checkstyle rules. Formatting belongs to Spotless (google-java-format), so no
  whitespace, indentation or line-length rule is here. What is here are the checks that find mistakes
  a formatter cannot. Every rule that is deliberately left out says why beside it.
-->
<module name="Checker">
  <property name="severity" value="warning"/>
  <property name="charset" value="UTF-8"/>

  <module name="NewlineAtEndOfFile"/>
  <module name="FileTabCharacter"/>

  <module name="TreeWalker">
    <module name="AvoidStarImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>
    <module name="IllegalImport"/>

    <module name="NeedBraces"/>
    <module name="EmptyBlock">
      <property name="option" value="text"/>
    </module>
    <module name="EmptyCatchBlock">
      <!-- A catch that ignores on purpose says so in a comment, as the SDK does. -->
      <property name="commentFormat" value=".+"/>
    </module>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <module name="EqualsHashCode"/>
    <module name="MissingOverride"/>
    <module name="ModifierOrder"/>
    <module name="RedundantModifier"/>
    <module name="UpperEll"/>
    <module name="ArrayTypeStyle"/>
    <module name="OneStatementPerLine"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="StringLiteralEquality"/>
    <module name="InnerAssignment"/>
    <module name="HideUtilityClassConstructor"/>
    <module name="FinalClass"/>
    <module name="OneTopLevelClass"/>
    <module name="PackageDeclaration"/>
    <module name="TodoComment">
      <!-- A TODO carries an issue in this repository: TODO(#123). -->
      <property name="format" value="TODO(?!\(#\d+\))"/>
    </module>

    <module name="MissingJavadocType">
      <!-- The public API is documented; tests and the test service are not public API. -->
      <property name="scope" value="public"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope" value="public"/>
      <property name="allowMissingPropertyJavadoc" value="true"/>
      <property name="tokens" value="METHOD_DEF"/>
    </module>

    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="ConstantName"/>
    <module name="PackageName"/>
  </module>

  <!--
    Left out on purpose:
    - IllegalCatch: the SDK's contract is that nothing throws at a caller, so it catches Throwable
      and RuntimeException at the edges by design.
    - MagicNumber: the protocol's numbers (500 entries, 300 s, 60 s) are named where they matter and the
      rest are in tests and the evaluator's specified constants.
    - DesignForExtension, FinalParameters, HiddenField, JavadocPackage: noise for a library of final
      classes whose constructors are private.
    - LineLength, Indentation, WhitespaceAround and the rest of the layout rules: google-java-format
      decides layout, and two tools deciding it would disagree.
  -->
</module>
