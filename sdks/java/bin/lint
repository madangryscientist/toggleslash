#!/usr/bin/env bash
# The native lint and format check, with no warnings allowed: Checkstyle over the SDK's own sources and
# google-java-format over every Java file. It changes nothing; `google-java-format --replace` fixes the layout.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$here"

# mise installs Checkstyle as a bare JAR. Under shims `command -v` finds the shim, so ask mise first.
checkstyle="$(mise which checkstyle 2>/dev/null || command -v checkstyle || true)"
if [ -z "$checkstyle" ]; then
  echo "bin/lint: checkstyle is not installed; run 'mise install' in sdks/java" >&2
  exit 1
fi
if ! command -v google-java-format >/dev/null 2>&1; then
  echo "bin/lint: google-java-format is not installed; run 'mise install' in sdks/java" >&2
  exit 1
fi

# Checkstyle exits 0 on warnings by default; the rule set is all errors, and a nonzero count fails here.
java -jar "$checkstyle" -c checkstyle.xml src/main/java

files="$(find src test-service/src -name '*.java' -type f | sort)"
# shellcheck disable=SC2086
google-java-format --dry-run --set-exit-if-changed $files
echo "lint ok"
