#!/bin/sh
# Read-only lint and format check, no warnings allowed:
#  - Spotless (google-java-format) over src/ and test-service/src/, so the SDK, its tests and the
#    test service are all format-checked;
#  - Checkstyle (checkstyle.xml) over src/main/java only: its Javadoc rules are meant for the
#    public API, so the tests and the test service are left out.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

run mvn -B -ntp -q spotless:check

# Checkstyle ships as a bare executable JAR; mise (or the CI setup step) puts it on PATH.
jar="$(run sh -c 'command -v checkstyle')"
# --fail-on-warning does not exist; every rule is severity error, so a violation exits non-zero.
run java -jar "$jar" -c checkstyle.xml src/main/java
