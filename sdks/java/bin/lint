#!/bin/sh
# The native lint and format check, with no warnings allowed.
#   google-java-format 2.0.0 or later formats nothing under --set-exit-if-changed unless it is told to, so it
#   runs over src/main/java, src/test/java and test-service/src and fails on any file it would change.
#   Checkstyle (checkstyle.xml names the rule set and the reason for each rule left out) runs over src/main/java.
set -eu
here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here"

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

files=$(find src/main/java src/test/java test-service/src -name '*.java' | sort)
# shellcheck disable=SC2086
run google-java-format --set-exit-if-changed --dry-run $files >/dev/null || {
  echo "google-java-format would change files; run google-java-format --replace on them" >&2
  # shellcheck disable=SC2086
  run google-java-format --set-exit-if-changed --dry-run $files >&2 || true
  exit 1
}

# Checkstyle installs as a bare JAR, not a script: find its path inside mise's environment and run it with java.
jar=$(run sh -c 'command -v checkstyle')
run java -jar "$jar" -c checkstyle.xml src/main/java
