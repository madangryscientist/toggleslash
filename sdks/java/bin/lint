#!/bin/sh
# The native lint and format check. Any finding fails; nothing is rewritten.
#   google-java-format --set-exit-if-changed --dry-run: layout, over every source root
#     (src/main, src/test and test-service/src; --dry-run alone prints and exits 0)
#   checkstyle (checkstyle.xml): the public API's rules, over src/main only
#   the compiler: -Xlint:all -Werror in pom.xml covers main, tests and the test service when bin/test builds
set -eu
cd "$(dirname "$0")/.."

run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

files=$(find src/main src/test test-service/src -name '*.java' | sort)
# shellcheck disable=SC2086
run google-java-format --set-exit-if-changed --dry-run $files

# Checkstyle is a bare JAR under mise: resolve its path inside mise (outside it the path is a shim that
# `java -jar` rejects as a corrupt jarfile).
jar=$(run sh -c 'command -v checkstyle')
run java -jar "$jar" -c checkstyle.xml src/main/java
