#!/bin/sh
# The native lint and format check. Any finding fails; there is no warning level. Nothing is rewritten.
# Roots each tool reads:
#   google-java-format --dry-run: src/main/java, src/test/java and test-service/src (every source)
#   checkstyle (checkstyle.xml): src/main/java only, the public API (doc comments, naming, hygiene)
#   javac -Xlint:all -Werror, through mvn test-compile: src/main/java, src/test/java and test-service/src
# A line the JVM prints about a tool itself (a deprecation notice from google-java-format's code on a
# newer JDK) is not a finding: it stays visible and RUN.md names it.
set -eu
cd "$(dirname "$0")/.."

run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

files=$(find src/main/java src/test/java test-service/src -name '*.java' | sort)
# shellcheck disable=SC2086
run google-java-format --dry-run --set-exit-if-changed $files

# Checkstyle is a bare jar: resolve its path under the toolchain, then run it with the same java.
jar=$(run sh -c 'command -v checkstyle')
run java -jar "$jar" -c checkstyle.xml src/main/java

run mvn --batch-mode --no-transfer-progress -q test-compile
