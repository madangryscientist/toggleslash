#!/bin/sh
# The native lint and format check; any finding fails it.
#
# google-java-format reads every Java root: src/main/java, src/test/java and test-service/src.
# Checkstyle reads src/main/java only, the public API, because its doc comment rules are meant for it.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  set -- mise exec --
else
  set --
fi

roots="src/main/java src/test/java test-service/src"

files=$(find $roots -name '*.java' | sort)
# shellcheck disable=SC2086
changed=$("$@" google-java-format --dry-run $files || true)
if [ -n "$changed" ]; then
  echo "google-java-format would change:" >&2
  echo "$changed" >&2
  exit 1
fi

# The Checkstyle distribution under mise is a bare JAR with no launcher. Resolve it inside mise
# (outside, the path is a shim that java -jar rejects).
jar=$("$@" sh -c 'command -v checkstyle')
out=$("$@" java -jar "$jar" -c checkstyle.xml src/main/java 2>&1) || {
  echo "$out" >&2
  exit 1
}
case "$out" in
*WARN* | *ERROR*)
  echo "$out" >&2
  exit 1
  ;;
esac
echo "lint ok"
