#!/bin/sh
# Starts the conformance test service. Builds the classes first only when they are missing.
set -eu
cd "$(dirname "$0")/.."
if [ ! -d target/classes ] || [ ! -d target/test-classes ] \
  || [ ! -f target/test-classes/com/github/madangryscientist/toggleslash/sdks/java/service/Main.class ]; then
  mise exec -- mvn -B -ntp -q test-compile >&2
fi
exec mise exec -- java -cp target/classes:target/test-classes \
  com.github.madangryscientist.toggleslash.sdks.java.service.Main
