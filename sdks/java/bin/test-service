#!/bin/sh
# Starts the conformance test service and prints "listening http://127.0.0.1:<port>" once it does.
# It runs the built classes; it builds them only when there are none (bin/test rebuilds every time).
set -eu
cd "$(dirname "$0")/.."

run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

SERVICE=target/test-classes/com/github/madangryscientist/toggleslash/sdks/java/testservice/TestService.class
if [ ! -f "$SERVICE" ]; then
  run mvn -B -q -DskipTests test-compile >&2
fi
exec mise exec -- java -cp target/classes:target/test-classes \
  com.github.madangryscientist.toggleslash.sdks.java.testservice.TestService
