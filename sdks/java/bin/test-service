#!/bin/sh
# Start the conformance test service (docs/sdk-test-service.md). Builds only when the classes are missing.
set -eu
cd "$(dirname "$0")/.."
if [ ! -f target/test-classes/com/github/madangryscientist/toggleslash/sdks/java/service/Main.class ] ||
  [ ! -d target/classes/com ]; then
  mise exec -- mvn -B -q -DskipTests test-compile >&2
fi
exec mise exec -- java -cp target/classes:target/test-classes \
  com.github.madangryscientist.toggleslash.sdks.java.service.Main "$@"
