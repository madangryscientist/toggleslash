#!/bin/sh
# Starts the conformance test service on a port it picks; prints "listening http://127.0.0.1:<port>".
set -eu
cd "$(dirname "$0")/.."
run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}
if [ ! -f target/classes/com/github/madangryscientist/toggleslash/sdks/java/Client.class ] ||
  [ ! -f target/test-classes/com/github/madangryscientist/toggleslash/sdks/java/testservice/Main.class ]; then
  run mvn -q -B test-compile >&2
fi
exec_java() {
  if command -v mise >/dev/null 2>&1; then
    exec mise exec -- java "$@"
  fi
  exec java "$@"
}
exec_java -cp target/classes:target/test-classes com.github.madangryscientist.toggleslash.sdks.java.testservice.Main
