#!/bin/sh
# Starts the Java SDK's conformance test service. It prints "listening http://127.0.0.1:<port>".
# The classes are built by `bin/test`; this builds them only when they are missing.
set -e
cd "$(dirname "$0")/.."
if [ ! -d target/classes ] || [ ! -d target/test-classes ]; then
  mise exec -- mvn -B -q -ntp -DskipTests test-compile >&2
fi
exec mise exec -- java -cp target/classes:target/test-classes \
  com.github.madangryscientist.toggleslash.sdks.java.testservice.Main
