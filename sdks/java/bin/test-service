#!/bin/sh
# Starts the conformance test service. Builds first only when the classes are missing; `bin/test` always builds.
set -eu
cd "$(dirname "$0")/.."
run() {
  if command -v mise >/dev/null 2>&1; then mise exec -- "$@"; else "$@"; fi
}
if [ ! -d target/classes ] || [ ! -d target/test-classes ]; then
  run mvn --batch-mode --quiet --no-transfer-progress test-compile >&2
fi
exec_java() {
  if command -v mise >/dev/null 2>&1; then exec mise exec -- java "$@"; else exec java "$@"; fi
}
exec_java -cp target/classes:target/test-classes \
  com.github.madangryscientist.toggleslash.sdks.java.testservice.Main
