#!/bin/sh
# Starts the conformance test service on a port the OS picks and prints
# "listening http://127.0.0.1:<port>". It runs the build that bin/test left in target/, and builds
# only if that is missing. Reads: target/classes and target/test-classes.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
cd "$here"

run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

if [ ! -f target/test-classes/testservice/Main.class ] || [ ! -f target/classes/com/github/madangryscientist/toggleslash/sdks/java/Client.class ]; then
  run mvn --batch-mode --no-transfer-progress -q test-compile >&2
fi

exec_java() {
  if command -v mise >/dev/null 2>&1; then
    exec mise exec -- java "$@"
  else
    exec java "$@"
  fi
}
exec_java -cp target/classes:target/test-classes testservice.Main
