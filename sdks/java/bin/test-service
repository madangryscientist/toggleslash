#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if command -v mise >/dev/null 2>&1; then
  set -- mise exec --
else
  set --
fi
# Build only when the classes are missing: bin/test builds them every time.
if [ ! -f target/test-classes/com/github/madangryscientist/toggleslash/sdks/java/testservice/Main.class ]; then
  "$@" mvn -B -q test-compile >&2
fi
exec "$@" java -cp target/classes:target/test-classes \
  com.github.madangryscientist.toggleslash.sdks.java.testservice.Main
