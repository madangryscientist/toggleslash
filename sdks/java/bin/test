#!/bin/sh
# Builds everything (the SDK, its tests and the test service), runs every native test (the evaluation
# vectors and bucket pins included) and prints how many vectors and pins ran. The test service is
# compiled with the tests, so bin/test-service finds it; bin/test-service builds only when it is missing.
set -eu
cd "$(dirname "$0")/.."

run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

mkdir -p target
counts="$PWD/target/vector-counts.txt"
rm -f "$counts"
export TOGGLESLASH_COUNTS_FILE="$counts"

# Build every time, so a stale build never hides a failure. Java has no race detector; the stress
# tests in src/test/java/.../ConcurrencyTest.java stand in for it.
run mvn --batch-mode --no-transfer-progress -q clean verify

cat "$counts"
