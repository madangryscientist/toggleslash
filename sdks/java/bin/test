#!/bin/sh
# Builds everything (the SDK, its tests and the test service), runs every native test (the evaluation
# vectors and bucket pins included) and prints how many vectors and pins ran. The test service is a
# test source root, so `mvn test` compiles it; bin/test-service runs it from target/.
set -eu
cd "$(dirname "$0")/.."

run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

mkdir -p target
rm -f target/vector-counts.txt
# `clean` every time, so a stale build never hides a failure. The race detector other languages have
# does not exist for the JVM; the stress tests in ConcurrencyTest stand in for it.
run mvn -B -q -ntp clean test
cat target/vector-counts.txt
