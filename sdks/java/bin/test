#!/bin/sh
# Builds everything (SDK, tests, test service), runs the native tests under surefire, and
# prints the vector line. `clean` first, so no result is ever a cached one.
set -eu
cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  run() { mise exec -- "$@"; }
else
  run() { "$@"; }
fi

rm -f target/vectors.txt
run mvn -B -ntp -q clean test
cat target/vectors.txt
