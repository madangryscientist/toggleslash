#!/bin/sh
# Build and test the SDK: the unit tests, the evaluation vectors and the test service's own tests.
set -eu
cd "$(dirname "$0")/.."
run() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}
rm -f target/vectors-count.txt
run mvn -q -B verify
if [ -f target/vectors-count.txt ]; then
  cat target/vectors-count.txt
fi
