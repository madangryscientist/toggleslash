#!/usr/bin/env bash
# Builds the SDK and runs every test: the evaluator's vectors, the client's unit tests and the test service's.
# The first run needs the network once, to fetch Maven plugins; later runs work offline.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$here"
if mvn --version >/dev/null 2>&1; then :; else
  echo "bin/test: mvn is not on PATH; run 'mise install' in sdks/java" >&2
  exit 1
fi
mvn --batch-mode --no-transfer-progress -Dstyle.color=never test "$@"
