#!/bin/sh
# Builds and tests the SDK, test service included. It always builds; it never reports a cached result.
# Prints "vectors: <n> pins: <n>" from the vector test, which writes the line to target/vectors.txt.
set -eu
here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here"
rm -f target/vectors.txt
if command -v mise >/dev/null 2>&1; then
  mise exec -- mvn --batch-mode --no-transfer-progress clean verify
else
  mvn --batch-mode --no-transfer-progress clean verify
fi
cat target/vectors.txt
