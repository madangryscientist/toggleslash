<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>Elastic-2.0</PackageLicenseExpression>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ToggleSlash.Server/ToggleSlash.Server.csproj" />
    <ProjectReference Include="../ToggleSlash.Evaluation/ToggleSlash.Evaluation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared vectors are read the same way here as by the evaluator's own tests. -->
    <Compile Include="../ToggleSlash.Evaluation.Tests/Fixtures.cs" Link="Fixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
