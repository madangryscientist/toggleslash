# Style and analyzer rules for `dotnet format` (server:lint) and the compiler. The rule set is the .NET analyzers at
# AnalysisMode Recommended (Directory.Build.props) with code style enforced in the build (EnforceCodeStyleInBuild),
# plus the style rules below. Every rule turned off has its reason directly above it. Every csproj treats warnings
# as errors, so a rule left on is enforced.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,slnx,json,yml,yaml,toml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:warning
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

# CA1711: AdminTokenPermission names a scoped token's read or write permission, a word of the admin API, not a
# System.Security permission type; AdminTokenSettingCollection is an xunit collection definition, named for [Collection].
dotnet_diagnostic.CA1711.severity = none

# CA1716: the server is an application and nothing references its assembly but its own tests, so a member name that
# is a VB keyword (StreamHeartbeat.Next) reaches no other language.
dotnet_diagnostic.CA1716.severity = none

[{ToggleSlash.Server.Tests,ToggleSlash.Evaluation.Tests}/**.cs]
# CA1707: test names are sentences (Bucket_matches_the_pin), the house style the SDK's tests also keep.
dotnet_diagnostic.CA1707.severity = none

# CA1861: a constant array in a test is the expected data beside its assertion and runs once per test; a static
# readonly field would move it away from the assertion.
dotnet_diagnostic.CA1861.severity = none

# EF Core writes the migrations (`dotnet ef migrations add`); they are regenerated, never hand-edited.
[ToggleSlash.Server/Data/Migrations/**.cs]
generated_code = true
