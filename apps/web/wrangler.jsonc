{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toggleslash-web",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // The dashboard is served only at flags.madangryscientist.com, which sits behind Cloudflare Access
  // (docs/dashboard-hosting.md). A real deploy attaches it as a custom domain and creates its DNS record.
  // No workers.dev or preview URL: either would reach the Worker without passing Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "flags.madangryscientist.com", "custom_domain": true }],
  // `CLOUDFLARE_ENV=e2e`: the Playwright build, which never deploys. It inherits the settings above but
  // not the route, so a stray e2e deploy could never claim the dashboard's hostname.
  "env": {
    "e2e": { "routes": [] },
  },
}
