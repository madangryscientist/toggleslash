    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "wrangler": "^4.160.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@playwright/test": "1.65.0",
    "@tanstack/router-cli": "^1.168.0",
