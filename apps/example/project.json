{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "example",
  "sourceRoot": "apps/example/src",
  "projectType": "application",
  "targets": {
    "typecheck": { "command": "tsc -p apps/example/tsconfig.json" },
    "lint": {
      "command": "oxlint --type-aware --deny-warnings apps/example && bun scripts/check-slop.ts apps/example"
    },
    "test": {
      "command": "bun --bun vitest run",
      "options": { "cwd": "apps/example" }
    }
  }
}
