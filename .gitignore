node_modules/
.moon/cache/

# the npm packages' build output (scripts/pack.ts, cli:build)
packages/*/dist/
packages/cli/LICENSE
packages/cli/NOTICE
packages/cli/*.tgz

# secrets
*.pem
.env
.dev.vars

# the server's SQLite file, wherever TOGGLESLASH_DB_PATH points inside the tree
*.db
*.db-journal
*.db-shm
*.db-wal

# Playwright's failure output (the stack journey in packages/e2e)
packages/e2e/test-results/

# the C# server's build output
apps/server/**/bin/
apps/server/**/obj/
apps/server/**/TestResults/
