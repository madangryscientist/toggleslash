{
  "name": "featureslash-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "featureslash": "bun packages/cli/src/index.ts",
    "typecheck": "bun scripts/nx.ts run-many -t typecheck",
    "lint": "bun scripts/nx.ts run-many -t lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "parity": "bun scripts/parity.ts --write",
    "parity:check": "bun scripts/parity.ts --check",
    "parity:check:commits": "bun scripts/parity-commits.ts",
    "build": "bun scripts/nx.ts run-many -t build",
    "test": "bun scripts/nx.ts run-many -t test",
    "test:e2e": "bun scripts/nx.ts run-many -t test:e2e",
    "test:stack": "bun scripts/nx.ts run e2e:test:stack",
    "stack": "bun packages/e2e/src/stack-cli.ts"
  },
  "devDependencies": {
    "@nx/dotnet": "24.0.3",
    "@types/bun": "1.4.4",
    "nx": "24.0.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
