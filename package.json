{
  "name": "toggleslash-workspace",
  "private": true,
  "license": "Elastic-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "toggleslash": "bun packages/cli/src/index.ts",
    "typecheck": "bun scripts/moon.ts run --concurrency 3 :typecheck",
    "lint": "bun scripts/moon.ts run --concurrency 3 :lint && bun scripts/check-dashes.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "parity": "bun scripts/parity.ts --write",
    "parity:check": "bun scripts/parity.ts --check",
    "parity:check:commits": "bun scripts/parity-commits.ts",
    "build": "bun scripts/moon.ts run --concurrency 3 :build",
    "test": "bun scripts/moon.ts run --concurrency 3 :test",
    "test:e2e": "bun scripts/moon.ts run --concurrency 3 :test-e2e",
    "test:stack": "bun scripts/moon.ts run e2e:test-stack",
    "stack": "bun packages/e2e/src/stack-cli.ts",
    "conformance": "bun packages/sdk-conformance/src/cli.ts"
  },
  "devDependencies": {
    "@moonrepo/cli": "2.6.5",
    "@types/bun": "1.4.4",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "trustedDependencies": [
    "@moonrepo/cli"
  ]
}
