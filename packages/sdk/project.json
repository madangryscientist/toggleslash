{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sdk",
  "sourceRoot": "packages/sdk/src",
  "projectType": "library",
  "targets": {
    "typecheck": { "command": "tsc -p packages/sdk/tsconfig.json" },
    "lint": {
      "command": "oxlint --type-aware --deny-warnings packages/sdk && bun scripts/check-slop.ts packages/sdk"
    },
    "test": {
      "command": "bun --bun vitest run",
      "options": { "cwd": "packages/sdk" }
    }
  }
}
